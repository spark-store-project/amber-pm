# apm(8) bash 补全（2.0.0 起为原生包管理）
# 安装位置：/usr/share/bash-completion/completions/apm

_apm_installed_pkgs() {
    local d base
    for d in /var/lib/apm/*/; do
        [ -d "$d" ] || continue
        base="$(basename -- "$d")"
        case "$base" in
            apm | db | lists | cache) continue ;;
        esac
        [ -f "$d/info" ] || [ -d "$d/files" ] || continue
        printf '%s\n' "$base"
    done
}

_apm_all_pkgs() {
    apm list --all 2>/dev/null | awk '{print $1}' | cut -d'/' -f1
}

_apm()
{
    local cur prev words cword
    _init_completion || return

    local commands="install reinstall remove purge autoremove autopurge update upgrade full-upgrade hold unhold list search show policy depends rdepends download clean migrate debug launch run sandbox-run bwrap-run ssinstall ssaudit amber xmp360 bronya help"

    if [ "$cword" -eq 1 ]; then
        COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
        return 0
    fi

    local cmd="${words[1]}"
    case "$cmd" in
        install|reinstall)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "--force-outside-paths --reinstall -y --yes" -- "$cur") )
                return 0
            fi
            COMPREPLY=( $(compgen -W "$(_apm_all_pkgs)" -- "$cur") )
            if [[ "$cur" == ./* || "$cur" == /* ]]; then
                _filedir deb
            fi
            ;;
        remove|purge|autoremove|autopurge|hold|unhold|launch|run|sandbox-run|bwrap-run)
            COMPREPLY=( $(compgen -W "$(_apm_installed_pkgs)" -- "$cur") )
            ;;
        show|policy|depends|rdepends|download|ssinstall|ssaudit)
            COMPREPLY=( $(compgen -W "$(_apm_all_pkgs)" -- "$cur") )
            if [[ "$cur" == ./* || "$cur" == /* ]]; then
                _filedir deb
            fi
            ;;
        list)
            COMPREPLY=( $(compgen -W "--installed --all --upgradable" -- "$cur") )
            ;;
        migrate|update|upgrade|clean|debug)
            COMPREPLY=( $(compgen -W "--dry-run" -- "$cur") )
            ;;
    esac
    return 0
}

complete -F _apm apm
