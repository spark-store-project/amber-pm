#!/bin/bash
VERSION=@VERSION@
# 获取脚本名称用于帮助信息
SCRIPT_NAME=$(basename "$0")
# APM 容器根目录。允许通过环境变量覆盖（测试 / 自定义安装位置），
# 与 AGENTS.md 中关于 PATH_PREFIX 的说明保持一致。
PATH_PREFIX="${PATH_PREFIX:-/var/lib/apm/apm/files/ace-env/}"
PATH_PREFIX="${PATH_PREFIX%/}"
# 进入容器执行命令的入口脚本
APM_RUN_EXEC="${APM_RUN_EXEC:-/var/lib/apm/apm/files/ace-run}"

# 日志统一写到 stderr：stdout 只留给命令本身的输出，
# 这样 `apm run <包> <命令> > 文件` 或命令替换都不会被日志污染。
log.warn()  { printf '[\033[33mWARN\033[0m]:  \033[1m%s\033[0m\n' "$*" >&2; }
log.error() { printf '[\033[31mERROR\033[0m]: \033[1m%s\033[0m\n' "$*" >&2; }
log.info()  { printf '[\033[96mINFO\033[0m]:  \033[1m%s\033[0m\n' "$*" >&2; }
log.debug() { printf '[\033[32mDEBUG\033[0m]: \033[1m%s\033[0m\n' "$*" >&2; }

