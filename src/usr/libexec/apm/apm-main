#!/bin/bash
VERSION=@VERSION@
APM_VERSION="$VERSION"
# 获取脚本名称用于帮助信息
SCRIPT_NAME=$(basename "$0")
# 进入容器执行命令的入口脚本
APM_RUN_EXEC="${APM_RUN_EXEC:-/var/lib/apm/apm/files/ace-run}"

# ---------------------------------------------------------------------------
# 加载原生包管理实现（本版本起不再依赖 apt/dpkg，也不再需要管理环境 rootfs）
# ---------------------------------------------------------------------------
_apm_self="$(readlink -f -- "${BASH_SOURCE[0]}")"
_apm_lib_dir="$(dirname -- "$_apm_self")"
for _apm_lib in apm-lib.sh apm-repo.sh apm-deb.sh apm-db.sh apm-install.sh apm-ss.sh apm-migrate.sh; do
    if [ ! -r "$_apm_lib_dir/$_apm_lib" ]; then
        echo "apm: 缺少 $_apm_lib（APM 安装可能不完整）" >&2
        exit 1
    fi
    # shellcheck disable=SC1090
    . "$_apm_lib_dir/$_apm_lib"
done

