#!/bin/bash
# =============================================================================
# amber-pm-upgrade-notifier —— 每日检查 APM 软件包更新并通知桌面用户
#
# 2.0.0 起使用原生包管理（apm update / apm list --upgradable），
# 不再需要管理环境、amber-pm-debug 或 dpkg-query。
# 由 apm-daily-update.service 以 root 身份运行。
# =============================================================================

# 当前桌面用户（用于发通知）
get_current_user() {
    local user
    user=$(who 2>/dev/null | awk 'NF { print $1; exit }')
    if [ -z "$user" ]; then
        user=$(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $3; exit}')
    fi
    if [ -z "$user" ] && [ -n "${SUDO_USER:-}" ]; then
        user="$SUDO_USER"
    fi
    printf '%s\n' "$user"
}

notify_user() {
    local user uid
    user="$(get_current_user)"
    [ -n "$user" ] || return 0
    uid="$(id -u "$user" 2>/dev/null)" || return 0
    if command -v notify-send >/dev/null 2>&1; then
        sudo -u "$user" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/${uid}/bus" \
            notify-send -a apm "$@" 2>/dev/null || true
    fi
}

network_check() {
    local target="www.baidu.com" timeout=15 ret_code
    ret_code="$(curl -I -s --connect-timeout "$timeout" "$target" -w '%{http_code}' 2>/dev/null | tail -n1)"
    [ "$ret_code" = "200" ]
}

# 等待网络恢复（指数退避，最长 12 小时）
wait_for_network() {
    local wait_time=15 max_wait=$((12 * 3600))
    while ! network_check; do
        echo "等待网络恢复，${wait_time} 秒后重试..."
        sleep "$wait_time"
        wait_time=$((wait_time * 2))
        [ "$wait_time" -gt "$max_wait" ] && wait_time=$max_wait
    done
}

main() {
    command -v apm >/dev/null 2>&1 || exit 0
    wait_for_network

    # 清理缓存与孤儿依赖
    apm clean >/dev/null 2>&1 || true
    apm autoremove -y >/dev/null 2>&1 || true

    # 更新仓库索引（失败重试，最多 12 次）
    local retry=0
    until apm update >/dev/null 2>&1; do
        if [ "$retry" -ge 12 ]; then
            echo "apm update 连续失败，退出"
            exit 1
        fi
        sleep 15
        retry=$((retry + 1))
    done

    local upgradable count
    upgradable="$(apm list --upgradable 2>/dev/null)"
    count="$(printf '%s\n' "$upgradable" | grep -v '^Listing\.\.\.$' | grep -c . || true)"
    if [ "${count:-0}" -le 0 ]; then
        exit 0
    fi

    notify_user "APM 琥珀应用包" "有 $count 个应用可以更新啦，执行 sudo apm upgrade 即可升级"
}

main "$@"
