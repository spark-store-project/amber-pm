    cat <<'EOF'
  _   __     ____            _       ____         __              
 | | / /__ _/ / /____ ______(_)__   / __/_ _____ / /____ __ _     
 | |/ / _ `/ /  '_/ // / __/ / -_) _\ \/ // (_-</ __/ -_)  ' \    
 |___/\_,_/_/_/\_\\_, /_/ /_/\__/ /___/\_, /___/\__/\__/_/_/_/    
  / /  ___ ___ __/___/____/ /         /___/                       
