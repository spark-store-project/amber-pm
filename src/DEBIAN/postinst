#!/bin/bash
# APM 的 Debian 维护者脚本
# 1.4.0 起不再需要初始化管理环境 rootfs：包管理已改为原生实现，
# 软件包直接安装在 /var/lib/apm/<包名>/。
export PACKAGE_NAME="$DPKG_MAINTSCRIPT_PACKAGE"

case "$1" in
	configure)
		systemctl daemon-reload || true
		systemctl enable apm-daily-update || true
		systemctl start apm-daily-update || true
		systemctl restart apparmor.service || true
		mkdir -p /etc/apparmor.d/disable/
		ln -sv /etc/apparmor.d/bwrap-userns-restrict /etc/apparmor.d/disable/ || true

		if [ -f /usr/lib/sysctl.d/apm.conf ]; then
			sysctl -p /usr/lib/sysctl.d/apm.conf || true
		fi
		systemctl reload apparmor || true

		# 发送统计信息
		/var/lib/apm/apm/files/feedback.sh &

		# 桌面集成
		amber-pm-dstore-patch || true
		amber-pm-desktop-fix || true

		# 旧版本留有管理环境时提示迁移（不自动执行，避免破坏用户数据）
		if [ -d /var/lib/apm/apm/files/ace-env ]; then
			echo "检测到旧版 APM 管理环境（1.3.x），请执行以下命令迁移已安装的软件包："
			echo "    sudo apm migrate"
		fi
		;;
	triggered)
		# 有软件包（包括用宿主 apt 安装的 APM 包）写入 /var/lib/apm 时重新做集成
		amber-pm-dstore-patch || true
		amber-pm-desktop-fix || true
		amber-pm-configure-nvidia-host || true
		;;
esac

true
