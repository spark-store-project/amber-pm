#!/bin/bash
# =============================================================================
# bin/ace-run —— 进入 APM 自身的基础环境（amber-pm-debug / `apm debug` 使用）。
#
# 注意：这个工具用来打开 APM 内置的 ACE 环境，不是用来启动普通应用的。
# 包名从脚本路径推导（/var/lib/apm/<包名>/files/bin/ace-run），也可以用
# ACE_PACKAGE_NAME 显式指定。
#
# 命令行参数原样传给容器内的命令（转义逻辑见 ace-run-lib.sh）。
# =============================================================================

# --- 定位并加载公共库 --------------------------------------------------------
_ace_script="$(readlink -f -- "${BASH_SOURCE[0]}")"
_ace_dir="$(dirname -- "$_ace_script")"
while [ "$_ace_dir" != "/" ] && [ ! -r "$_ace_dir/ace-run-lib.sh" ]; do
    _ace_dir="$(dirname -- "$_ace_dir")"
done
if [ ! -r "$_ace_dir/ace-run-lib.sh" ]; then
    echo "ace-run: 找不到 ace-run-lib.sh，APM 安装可能不完整" >&2
    exit 1
fi
# shellcheck source=ace-run-lib.sh
. "$_ace_dir/ace-run-lib.sh"

# 脚本位于 /var/lib/apm/<包名>/files/bin/ace-run，往上三层就是包目录
_ace_pkg_dir="$(dirname -- "$(dirname -- "$(dirname -- "$_ace_script")")")"
ACE_PACKAGE_NAME="${ACE_PACKAGE_NAME:-$(basename -- "$_ace_pkg_dir")}"
export ACE_PACKAGE_NAME

chrootEnvPath="${chrootEnvPath:-/var/lib/apm/${ACE_PACKAGE_NAME}/files/ace-env}"
HOME="$(ace_home)"
export HOME

if [ ! -d "$chrootEnvPath" ]; then
    ace_warn "容器根目录不存在：$chrootEnvPath"
    exit 1
fi

uid="$(ace_runtime_uid)"
container_path="$(ace_container_path)"

ACE_BWRAP_SETENV=(
    --setenv FAKEROOTDONTTRYCHOWN 1
    --setenv PULSE_SERVER "/run/user/${uid}/pulse/native"
    --setenv PATH "$container_path"
    --setenv IS_ACE_ENV 1
    --setenv IS_APM_ENV 1
    --setenv XDG_DATA_DIRS "/amber-ce-tools/additional-data-dir-in-container:${XDG_DATA_DIRS:-}"
)

ACE_BWRAP_BINDS=(
    --dev-bind "${chrootEnvPath%/}/" /
    --dev-bind-try /media /media
    --dev-bind-try /root /root
    --dev-bind-try /www /www
    --dev-bind-try /mnt /mnt
    --dev-bind-try /tmp /tmp
    --dev-bind-try /data /data
    --dev-bind-try /dev /dev
    --proc /proc
    --dev-bind /sys /sys
    --dev-bind /run /run
    --dev-bind-try "/run/user/${uid}/pulse" "/run/user/${uid}/pulse"
    --dev-bind / /host
    --dev-bind-try /etc/resolv.conf /etc/resolv.conf
    --dev-bind-try /home /home
)

ace_run_container "$@"
