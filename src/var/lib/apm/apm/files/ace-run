#!/bin/bash
# =============================================================================
# ace-run —— `apm run` 进入应用容器的入口。
#
# 由 /usr/libexec/apm/apm-main 以 chrootEnvPath=<overlay 挂载点> 调用，
# 也可以直接执行（此时 chrootEnvPath 默认为脚本旁边的 ace-env）。
#
# 可覆盖的环境变量：
#   chrootEnvPath    容器根目录（overlay 挂载点或 ace-env 目录）
#   APM_PKG_NAME     当前包名，默认 apm-general
#   APM_USE_SANDBOX  为 1 时把 $HOME 沙箱化到 ~/.apm/<包名>
#
# 命令行参数原样传给容器内的命令：空格、引号、$、反引号、反斜杠、换行都会被
# 完整保留（参数拼装与转义逻辑见 ace-run-lib.sh）。
# =============================================================================

# --- 定位并加载公共库（通过 /usr/bin 软链接调用时也能正确解析） --------------
_ace_script="$(readlink -f -- "${BASH_SOURCE[0]}")"
_ace_dir="$(dirname -- "$_ace_script")"
while [ "$_ace_dir" != "/" ] && [ ! -r "$_ace_dir/ace-run-lib.sh" ]; do
    _ace_dir="$(dirname -- "$_ace_dir")"
done
if [ ! -r "$_ace_dir/ace-run-lib.sh" ]; then
    echo "ace-run: 找不到 ace-run-lib.sh，APM 安装可能不完整" >&2
    exit 1
fi
# shellcheck source=ace-run-lib.sh
. "$_ace_dir/ace-run-lib.sh"

chrootEnvPath="${chrootEnvPath:-$_ace_dir/ace-env}"
APM_PKG_NAME="${APM_PKG_NAME:-apm-general}"
HOME="$(ace_home)"
export HOME

if [ ! -d "$chrootEnvPath" ]; then
    ace_warn "容器根目录不存在：$chrootEnvPath"
    exit 1
fi

uid="$(ace_runtime_uid)"
container_path="$(ace_container_path)"

# --- 家目录下应用可写的目录 --------------------------------------------------
ace_ensure_dir "$HOME/.apm/${APM_PKG_NAME}" || true

# 沙盒模式下，桌面/文档等目录需要先在沙箱里建好，再把主机目录挂进去
XDG_DIR_NAMES=(DESKTOP DOCUMENTS PICTURES DOWNLOAD VIDEOS MUSIC)
sandbox_xdg_dirs=()
if [ "${APM_USE_SANDBOX:-0}" = "1" ]; then
    for _xdg_name in "${XDG_DIR_NAMES[@]}"; do
        _xdg_path="$(xdg-user-dir "$_xdg_name" 2>/dev/null)" || continue
        [ -n "$_xdg_path" ] || continue
        ace_ensure_dir "$HOME/.apm/${APM_PKG_NAME}/$(basename -- "$_xdg_path")" || true
        sandbox_xdg_dirs+=("$_xdg_path")
    done
fi

# --- 环境变量 ----------------------------------------------------------------
ACE_BWRAP_SETENV=(
    --setenv FAKEROOTDONTTRYCHOWN 1
    --setenv PULSE_SERVER "/run/user/${uid}/pulse/native"
    --setenv PATH "$container_path"
    --setenv IS_ACE_ENV 1
    --setenv GTK_USE_PORTAL 1
    --setenv XDG_DATA_DIRS "/amber-ce-tools/additional-data-dir-in-container:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
    --setenv XCURSOR_PATH "/host/usr/share/icons:/host/usr/share/cursors:/usr/share/icons:/usr/share/cursors:${XCURSOR_PATH:-}"
)

# --- 主机 PipeWire 客户端运行文件（Wayland 屏幕共享需要） ---------------------
# APM 的基础环境里通常只有 libpipewire 运行库（由 ffmpeg 等依赖带入），
# 但 Debian 系发行版把客户端配置 client.conf 放在 pipewire-bin 包里，
# 把 protocol-native 等客户端模块放在 libpipewire-0.3-modules 包里。
# 两者缺失时 pw_context_new() 会直接失败（报 can't load config client.conf），
# 依赖 PipeWire 的应用（Wayland 下的屏幕共享/录屏，如腾讯会议）就会在请求
# xdg-desktop-portal 之前中断，表现为“点共享屏幕没反应 / Portal 授权对话框不弹出”。
# 主机 PipeWire 的 socket 已经通过 --dev-bind /run 暴露进来，
# 这里在容器缺少客户端运行文件时借用主机的（/host 为宿主机根目录）。
_ace_needs_host_pipewire() {
    local d
    # 容器内没有 PipeWire 的配置/模块时不需要借用主机文件
    [ -d "${chrootEnvPath}/usr/share/pipewire" ] || return 1
    # 容器已有自己的客户端模块时保持原样
    for d in "${chrootEnvPath}"/usr/lib/*-linux-gnu/pipewire-0.3 \
             "${chrootEnvPath}"/usr/lib64/pipewire-0.3 \
             "${chrootEnvPath}"/usr/lib/pipewire-0.3; do
        [ -d "$d" ] && return 1
    done
    return 0
}

if _ace_needs_host_pipewire; then
    if [ -f /usr/share/pipewire/client.conf ]; then
        ACE_BWRAP_SETENV+=(--setenv PIPEWIRE_CONFIG_DIR /host/usr/share/pipewire)
    fi
    for d in /usr/lib/*-linux-gnu/pipewire-0.3 /usr/lib64/pipewire-0.3 /usr/lib/pipewire-0.3; do
        if [ -d "$d" ]; then
            ACE_BWRAP_SETENV+=(--setenv PIPEWIRE_MODULE_DIR "/host$d")
            break
        fi
    done
    for d in /usr/lib/*-linux-gnu/spa-0.2 /usr/lib64/spa-0.2 /usr/lib/spa-0.2; do
        if [ -d "$d" ]; then
            ACE_BWRAP_SETENV+=(--setenv SPA_PLUGIN_DIR "/host$d")
            break
        fi
    done
fi

# --- 目录绑定 ----------------------------------------------------------------
ACE_BWRAP_BINDS=(
    --dev-bind "${chrootEnvPath%/}/" /
    --dev-bind-try /media /media
    --dev-bind-try /mnt /mnt
    --dev-bind-try /tmp /tmp
    --dev-bind-try /data /data
    --dev-bind-try /dev /dev
    --proc /proc
    --dev-bind /sys /sys
    --dev-bind /run /run
    --dev-bind-try "/run/user/${uid}/pulse" "/run/user/${uid}/pulse"
    --dev-bind / /host
    --dev-bind-try /etc/resolv.conf /etc/resolv.conf
    --dev-bind-try /usr/share/icons /usr/local/share/icons
    --dev-bind-try /usr/share/fonts /usr/local/share/fonts
    --dev-bind-try /usr/share/themes /usr/share/themes
    --dev-bind-try /home /home
    --dev-bind-try "$HOME/.apm/${APM_PKG_NAME}/.deepinwine" "$HOME/.deepinwine"
)

if [ "${APM_USE_SANDBOX:-0}" = "1" ]; then
    ACE_BWRAP_BINDS+=(--dev-bind-try "$HOME/.apm/${APM_PKG_NAME}/" "$HOME/")
    for _xdg_path in "${sandbox_xdg_dirs[@]}"; do
        ACE_BWRAP_BINDS+=(--dev-bind-try "$_xdg_path" "$_xdg_path")
    done
else
    ACE_BWRAP_BINDS+=(--dev-bind-try "$HOME/.deepinwine" "$HOME/.deepinwine")
fi

ace_run_container "$@"
