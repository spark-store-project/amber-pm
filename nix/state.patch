 # 小工具
 # ---------------------------------------------------------------------------
 apm_pkg_root() { printf '%s/var/lib/apm/%s\n' "$APM_ROOT" "$1"; }
+
+# Old files.list records may predate the Nix ownership boundary. Application
+# removal and upgrades must not unlink the program or erase its private state.
+_apm_nix_protected_path() {
+    case "$1" in
+        /var/lib/apm/apm | /var/lib/apm/apm/* | \
+        /var/lib/apm/apm-conf | /var/lib/apm/apm-conf/* | \
+        /var/lib/apm/apm-compat | /var/lib/apm/apm-compat/*) return 0 ;;
+    esac
+    return 1
+}
 
